.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.textarea {
  font-size: 28rpx;
  min-height: 120rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx;
}

.picker {
  font-size: 28rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.success-tip {
  text-align: center;
  color: #07c160;
  font-size: 26rpx;
  margin-top: 16rpx;
}
