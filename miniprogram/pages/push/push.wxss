.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.time-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.time-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time-label {
  font-size: 26rpx;
  color: #666;
}

.time-value {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

.hint {
  font-size: 24rpx;
  color: #999;
}

.btn-row {
  padding: 20rpx 0 40rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.saved-tip {
  text-align: center;
  color: #07c160;
  font-size: 24rpx;
  padding: 10rpx 0 30rpx;
}
