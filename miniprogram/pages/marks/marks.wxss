.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.filter {
  font-size: 28rpx;
  color: #07c160;
  text-align: center;
  padding: 10rpx 0;
}

.empty {
  text-align: center;
  color: #999;
  padding: 20rpx 0;
}

.mark-msg {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.mark-reason {
  font-size: 24rpx;
  color: #e64340;
  margin-bottom: 4rpx;
}

.mark-meta {
  font-size: 22rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.mark-status {
  text-align: right;
}

.mark-status.resolved {
  color: #07c160;
  font-size: 24rpx;
  text-align: right;
}
