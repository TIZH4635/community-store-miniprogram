.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.textarea {
  font-size: 28rpx;
  min-height: 120rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.result-row {
  margin-bottom: 12rpx;
}

.result-label {
  color: #666;
  font-size: 26rpx;
}

.text-red { color: #e64340; }
.text-green { color: #07c160; }

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.keyword-tag {
  background: #fff1f0;
  color: #e64340;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 24rpx;
}
