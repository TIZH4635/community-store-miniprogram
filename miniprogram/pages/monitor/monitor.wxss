.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.textarea {
  font-size: 28rpx;
  min-height: 100rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.msg-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.msg-abnormal {
  background: #fff1f0;
  margin: -12rpx;
  padding: 12rpx;
  border-radius: 8rpx;
}

.msg-text {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.msg-meta {
  font-size: 22rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.msg-ai {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.ai-label {
  color: #666;
}

.ai-category {
  color: #e64340;
  font-weight: bold;
}

.ai-reason {
  color: #999;
  margin-left: 8rpx;
}

.msg-status {
  margin-top: 8rpx;
}

.status-pending { color: #e64340; font-size: 24rpx; }
.status-confirmed { color: #07c160; font-size: 24rpx; }
.status-rejected { color: #999; font-size: 24rpx; }
.status-ok { color: #07c160; font-size: 24rpx; }

.msg-actions {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 20rpx 0;
}
