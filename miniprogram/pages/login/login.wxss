.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 48rpx 32rpx;
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.center {
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 48rpx;
  line-height: 160rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-login {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
}
